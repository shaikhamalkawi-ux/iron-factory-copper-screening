type: dataset
title: "Iron Factory copper screening: data and reproducibility code"
authors:
  - family-names: Malkawi
    given-names: Ghassan
version: 11.0.0
doi: 10.5281/zenodo.23019081
repository-code: "https://github.com/shaikhamalkawi-ux/iron-factory-copper-screening"
